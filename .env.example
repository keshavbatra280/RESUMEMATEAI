# ---- Server (copy this file to .env in the project root) ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ---- Client (set in client/.env or in Vercel dashboard) ----
# Leave empty in local development (Vite proxies /api to the server).
# In production set to your deployed backend URL, e.g. https://resumemate-api.onrender.com
VITE_API_URL=
